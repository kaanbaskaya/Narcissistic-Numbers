  3.9909728873006344`*^9, 3.9912779642067966`*^9, 3.9912856178886166`*^9, 
  3.99128684033333*^9, 3.991286926042822*^9, 3.991286966022747*^9, 
  3.991287477351614*^9, 3.991287517085846*^9, 3.991724350844324*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"56973525-2356-3e40-b93c-65606d682900"]
