Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissisticPermutationRangeParallel", "[", 
   RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "time", ",", "numbers", ",", "minDigits", ",", "maxDigits", ",", 
      "vectors"}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$KernelCount", "==", "0"}], ",", 
       RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DistributeDefinitions", "[", 
      RowBox[{
      "digitVector", ",", "digitVectorsOfLength", ",", 
       "permutationClassVectorPowerSum"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minDigits", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"IntegerLength", "[", "lower", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxDigits", "=", 
      RowBox[{"IntegerLength", "[", "upper", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"vectors", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"digitVectorsOfLength", "[", "d", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "minDigits", ",", "maxDigits"}], "}"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numbers", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "value", "}"}], ",", 
             RowBox[{
              RowBox[{"value", "=", 
               RowBox[{"permutationClassVectorPowerSum", "[", "v", "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"lower", "<=", "value", "<=", "upper"}], "&&", 
                 RowBox[{
                  RowBox[{"digitVector", "[", "value", "]"}], "==", "v"}]}], ",",
                 "value", ",", "Nothing"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"v", ",", "vectors"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"DeleteDuplicates", "[", "numbers", "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.990968763965849*^9, 3.9909696389110146`*^9, 
  3.990970047211872*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"c777cbb8-ca3a-6a42-b098-51c3effc3bbe"],

