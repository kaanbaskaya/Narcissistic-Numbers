b88eb03e0623"],

Cell[TextData[{
 "Goal: Find as many Narcissistic Numbers as possible\n\nDefinition: A number \
that can be recreated by summing each of their digits raised to the power of \
the total number of digits in the number itself.\n\nExample: 153 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["1", "3"], "+", 
    SuperscriptBox["5", "3"], "+", 
    SuperscriptBox["3", "3"]}], TraditionalForm]],ExpressionUUID->
  "b33b0b03-28ec-408f-89ba-6b1eafb440bc"],
 " (Note: 153 = 1 + 125 + 27)\n\nQualitity Function:"
}], "Text",
 CellChangeTimes->{{3.6551323318137064`*^9, 3.655132346618133*^9}, {
   3.6558834788297663`*^9, 3.655883482105772*^9}, {3.655883581805547*^9, 
   3.655883589683561*^9}, {3.6558837346868153`*^9, 3.655883735919217*^9}, {
   3.694341574232729*^9, 3.694341596852769*^9}, {3.694342244717239*^9, 
   3.694342247462844*^9}, {3.694342333660995*^9, 3.694342343083412*^9}, {
   3.6943424202555304`*^9, 3.694342429299047*^9}, {3.6943424762647333`*^9, 
   3.694342484642213*^9}, {3.694342535512122*^9, 3.694342552269081*^9}, {
   3.6943425832578535`*^9, 3.694342597036641*^9}, {3.694342646046445*^9, 
   3.694342765915301*^9}, {3.694342880577859*^9, 3.694342892973568*^9}, {
   3.920005136849468*^9, 3.9200051373384686`*^9}, {3.990602085066781*^9, 
   3.990602120169264*^9}, {3.990602153733088*^9, 3.990602203951949*^9}, {
   3.990602278467657*^9, 3.990602374346887*^9}, {3.990602419371594*^9, 
   3.9906026397732477`*^9}, {3.990602716868236*^9, 3.990602717058901*^9}, 
   3.9909719645023327`*^9, {3.991660360325927*^9, 3.991660402043426*^9}, {
   3.99166046948988*^9, 3.991660494167797*^9}, {3.991660535699862*^9, 
   3.991660536146364*^9}, 3.991660581431945*^9, {3.9916606228035793`*^9, 
   3.99166063138702*^9}},ExpressionUUID->"9fa5a7f9-5403-1c4d-b45f-\
fc3fdf894aee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QF", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"n", "-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"IntegerDigits", "[", "n", "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], "^", 
        RowBox[{"IntegerLength", "[", "n", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"IntegerLength", "[", "n", "]"}]}], "}"}]}], "]"}]}], ")"}], 
   "^", "2"}]}]], "Input",
 CellChangeTimes->{{3.991660609896104*^9, 3.991660610926627*^9}, 
   3.991660654470783*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"c63a2890-e288-4463-9d3b-9f469c944c68"],

