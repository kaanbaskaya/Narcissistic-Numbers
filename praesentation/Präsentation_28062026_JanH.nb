Cell[CellGroupData[{

Cell["2.4 Digit Permutation Class Approach parallelized", "Subsection",
 CellChangeTimes->{{3.9909639535543175`*^9, 3.9909639831622295`*^9}, {
  3.991661418606634*^9, 
  3.991661418653954*^9}},ExpressionUUID->"a98e62d1-fc04-0345-a484-\
e37d41bfe788"],

Cell["\<\
A further optimization is to parallelize this process

each digit composition can be evaluated independently -> the workload can be \
distributed across multiple processor cores

This means several digit classes are checked at the same time\
\>", "Text",
 CellChangeTimes->{
  3.9909642406133976`*^9, {3.9909642991457653`*^9, 3.990964310685255*^9}, 
   3.9916540197672787`*^9, 3.9916551426595306`*^9, 3.991655379223318*^9, 
