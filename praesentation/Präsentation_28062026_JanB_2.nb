Cell[CellGroupData[{

Cell["2.2 Brute force parallelized", "Subsection",
 CellChangeTimes->{{3.6943454921732183`*^9, 3.6943455089276485`*^9}, {
  3.990603430135974*^9, 3.990603430747066*^9}, {3.9909528755787086`*^9, 
  3.990952877741169*^9}, {3.9916614097078447`*^9, 
  3.9916614097504187`*^9}},ExpressionUUID->"64d905b6-1c05-4671-a397-\
d9051e682947"],

Cell["\<\
The brute force approach can be improved by parallelizing the evaluation of \
the candidate numbers. Since the quality function can be applied to each \
number independently, the search range is distributed across multiple \
Mathematica subkernels using ParallelTable. Each candidate number is tested \
by evaluating QF[n], and numbers with QF[n] = 0 are identified as \
narcissistic numbers.

Although this reduces the computation time, the algorithm still checks every \
number in the given range. Therefore, the parallelized brute force approach \
improves practical runtime but does not solve the scalability problem of the \
original brute force method.\
\>", "Text",
 CellChangeTimes->{{3.6551323318137064`*^9, 3.655132346618133*^9}, {
   3.6558834788297663`*^9, 3.655883482105772*^9}, {3.655883581805547*^9, 
   3.655883589683561*^9}, {3.6558837346868153`*^9, 3.655883735919217*^9}, {
   3.694341574232729*^9, 3.694341596852769*^9}, {3.694342244717239*^9, 
   3.694342247462844*^9}, {3.694342333660995*^9, 3.694342343083412*^9}, {
   3.6943424202555304`*^9, 3.694342429299047*^9}, {3.6943424762647333`*^9, 
   3.694342484642213*^9}, {3.694342535512122*^9, 3.694342552269081*^9}, {
   3.6943425832578535`*^9, 3.694342597036641*^9}, {3.694342646046445*^9, 
   3.694342765915301*^9}, {3.694342880577859*^9, 3.694342892973568*^9}, {
   3.920005136849468*^9, 3.9200051373384686`*^9}, 
   3.9906859003810406`*^9},ExpressionUUID->"720fd0cf-3b1a-5641-91db-\
187a96969d99"],

Cell["\<\
The following table shows the narcissistic numbers found up to each upper \
bound and the corresponding computation time of the parallelized brute force \
implementation.\
\>", "Text",
 CellChangeTimes->{{3.9909717519594116`*^9, 
  3.9909717708971577`*^9}},ExpressionUUID->"527c0e14-ff51-cf40-b74b-\
54389d56766f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "dimensionRange", "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dimensionRange", "[", "d_Integer", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"d", "==", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"10", "^", "d"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"maxdimensionParallelBF", "=", "6"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9912867768141174`*^9, 3.9912870979563217`*^9, {3.991287482342119*^9, 
   3.9912874826795063`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"65e5000f-5307-b049-bdc2-0ba053893d2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "returnNarcissisticParallelRange", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"returnNarcissisticParallelRange", "[", 
   RowBox[{"lower_Integer", ",", "upper_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time", ",", "numbers"}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$KernelCount", "==", "0"}], ",", 
       RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DistributeDefinitions", "[", 
      RowBox[{"F", ",", "QF"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QF", "[", "i", "]"}], "==", "0"}], ",", "i", ",", 
           "Nothing"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "lower", ",", "upper"}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{
  3.6943456316374636`*^9, 3.990683214282364*^9, {3.9906834350036945`*^9, 
   3.99068343983642*^9}, 3.990684023668535*^9, 3.9906854977951145`*^9, {
   3.9906856666084213`*^9, 3.9906856681560345`*^9}, {3.990685711258293*^9, 
   3.990685712462679*^9}, {3.9912868127997417`*^9, 3.991286823575615*^9}, {
   3.9912868687095203`*^9, 3.991286869273369*^9}, 3.9912871080602036`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"63973c09-62b7-45ce-8eee-a870279ee06a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rows", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lower", ",", "upper", ",", "numbers", ",", "time"}], "}"}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"lower", ",", "upper"}], "}"}], "=", 
          RowBox[{"dimensionRange", "[", "d", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"numbers", ",", "time"}], "}"}], "=", 
          RowBox[{"returnNarcissisticParallelRange", "[", 
           RowBox[{"lower", ",", "upper"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"d", ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"lower", ",", "\"\< - \>\"", ",", "upper"}], "}"}], 
            "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"numbers", ",", "\"\<; \>\""}], "]"}], ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"time", ",", 
             RowBox[{"{", 
              RowBox[{"Infinity", ",", "3"}], "}"}]}], "]"}]}], "}"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "1", ",", "maxdimensionParallelBF"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{"rows", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Digit length\>\"", ",", "\"\<Search range\>\"", 
       ",", "\"\<Numbers\>\"", ",", "\"\<Time in seconds\>\""}], "}"}]}], 
    "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.9906856013636265`*^9, 3.990685646808157*^9, {3.990958179963732*^9, 
