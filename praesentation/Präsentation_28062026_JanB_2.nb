         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"], 
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, GridBoxItemSize -> Automatic, 
    BaselinePosition -> {1, 1}]& ),
  Editable->True,
  InterpretationFunction->(RowBox[{"Legended", "[", 
     RowBox[{#, ",", 
       RowBox[{"Placed", "[", 
         RowBox[{#2, ",", "After"}], "]"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{3.9912780227045803`*^9, 3.9912858050211353`*^9, 
  3.9912878950202713`*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"169d8261-804b-3d44-9023-2f057ddaff8c"]
}, Open  ]],

Cell["\<\
The plot shows that the brute force methods become increasingly expensive as \
the digit length grows. Parallel brute force reduces the runtime compared to \
the sequential brute force method for larger dimensions, but the overall \
growth trend remains similar. The digit permutation class approaches show a \
much flatter runtime increase, which demonstrates their lower sensitivity to \
the size of the original search space. For the tested dimensions, the \
non-parallel digit permutation class approach performs best overall.\
\>", "Text",
 CellChangeTimes->{
  3.9915577277806873`*^9},ExpressionUUID->"7cf5a654-3229-544a-a09e-\
93e680914942"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"fb4669f3-4228-d544-a536-2527b0c718e3"],

Cell[CellGroupData[{

Cell["3.3 Sensitivity to Parallelization", "Subsection",
 CellChangeTimes->{{3.6943454921732183`*^9, 3.6943455118916535`*^9}, 
   3.694345567521351*^9, {3.991277498769907*^9, 3.991277505923517*^9}, 
   3.9915490610829945`*^9, {3.991661429421526*^9, 
   3.9916614294725447`*^9}},ExpressionUUID->"66d7956e-b8c1-4f20-942d-\
92195bf5d549"],

Cell["\<\
The third sensitivity parameter is the degree of parallelization. Parallel \
execution can reduce runtime when the workload is large enough to compensate \
for the overhead of managing multiple kernels. However, for small search \
spaces, this overhead can dominate the actual computation time.

The results indicate that parallelization is not universally beneficial. \
Especially for smaller digit dimensions, the non-parallel digit permutation \
class approach can be faster because it avoids kernel startup and \
communication overhead. For larger dimensions, parallelization may become \
more useful, but this depends on the number of available processor cores and \
the size of the generated digit vector list.

Therefore, the sensitivity analysis shows that parallelization should not be \
treated as an automatic optimization. It is only advantageous when the \
computational workload per parallel task is sufficiently large.\
\>", "Text",
 CellChangeTimes->{{3.6551323318137064`*^9, 3.655132346618133*^9}, {
   3.6558834788297663`*^9, 3.655883482105772*^9}, {3.655883581805547*^9, 
   3.655883589683561*^9}, {3.6558837346868153`*^9, 3.655883735919217*^9}, {
   3.694341574232729*^9, 3.694341596852769*^9}, {3.694342244717239*^9, 
   3.694342247462844*^9}, {3.694342333660995*^9, 3.694342343083412*^9}, {
   3.6943424202555304`*^9, 3.694342429299047*^9}, {3.6943424762647333`*^9, 
   3.694342484642213*^9}, {3.694342535512122*^9, 3.694342552269081*^9}, {
   3.6943425832578535`*^9, 3.694342597036641*^9}, {3.694342646046445*^9, 
   3.694342765915301*^9}, {3.694342880577859*^9, 3.694342892973568*^9}, {
   3.920005136849468*^9, 3.9200051373384686`*^9}, 
   3.9912775091683292`*^9},ExpressionUUID->"351a3f16-06d1-e046-a152-\
9222a45f5c1c"],

Cell["\<\
The following table investigates how the runtime of the parallel digit \
permutation class approach changes when the number of Mathematica kernels is \
varied. The test is performed for digit length 10 in order to create a \
workload that is large enough for parallelization to become relevant.\
\>", "Text",
 CellChangeTimes->{
  3.9915577759561844`*^9},ExpressionUUID->"fd991fe0-9484-ac43-9cf0-\
5edf1e3570eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"Clear", "[", "kernelSensitivityRows", "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testDimension", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kernelCounts", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Min", "[", 
        RowBox[{"6", ",", "$ProcessorCount"}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kernelSensitivityRows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CloseKernels", "[", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"LaunchKernels", "[", "kernels", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"numbers", ",", "time"}], "}"}], "=", 
         RowBox[{"returnNarcissisticPermutationRangeParallel", "@@", 
          RowBox[{"dimensionRange", "[", "testDimension", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"kernels", ",", "testDimension", ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"time", ",", 
            RowBox[{"{", 
             RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}], ",", 
          RowBox[{"Length", "[", "numbers", "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"kernels", ",", "kernelCounts"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CloseKernels", "[", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"kernelSensitivityRows", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Kernels\>\"", ",", "\"\<Digit length\>\"", 
         ",", "\"\<Time in seconds\>\"", ",", "\"\<Numbers found\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.6943456316374636`*^9, 3.991277522040062*^9, {3.991288097874691*^9, 
   3.991288099051054*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"4ee590ab-0481-4346-98bd-f9b88906f59d"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Kernels\"\>", "\<\"Digit length\"\>", "\<\"Time in seconds\"\>", \
"\<\"Numbers found\"\>"},
    {"1", "10", 
