Cell[CellGroupData[{

Cell["3 Possible Generalizations of the Problem ", "Section",
 PageBreakAbove->True,
 CellChangeTimes->{{3.694341537930465*^9, 3.694341550254487*^9}, {
   3.694342355079833*^9, 3.694342363410248*^9}, 3.6943428651189747`*^9, {
   3.6943430193857985`*^9, 3.694343019923829*^9}, {3.6943431695433865`*^9, 
   3.694343174763685*^9}, 3.69434557823857*^9, 3.920005231276169*^9, {
   3.991661384397471*^9, 3.991661384452471*^9}, {3.991661432570875*^9, 
   3.991661432653263*^9}},ExpressionUUID->"705b9c56-25e1-487f-9053-\
b5434709e0e3"],

Cell[TextData[{
 "The concept of narcissistic numbers can be extended in several ways.\n\n",
 StyleBox["Narcissistic numbers with different bases.\n",
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 "\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["62", "10"], TraditionalForm]],ExpressionUUID->
  "c04cf943-71d4-4a84-afe5-2b77eb83f501"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["332", "4"], TraditionalForm]],ExpressionUUID->
  "8a2bf15f-771b-4846-b82e-30fbe9b6c311"],
 ", we can say: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", "3"], TraditionalForm]],ExpressionUUID->
  "e391e4de-9e26-4df8-901f-5dc7a7e83cc0"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", "3"], TraditionalForm]],ExpressionUUID->
  "f5f39d86-e233-453a-96dc-665bd1c32485"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "3"], TraditionalForm]],ExpressionUUID->
  "88d83424-9c5c-4e3c-9e33-77820318085f"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"62", "  "}], TraditionalForm]],ExpressionUUID->
  "3a30eda4-8e47-4a5e-9b3d-c6963da772d1"],
 "\n\nSo ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["62", "10"], TraditionalForm]],ExpressionUUID->
  "95a787a4-b183-478c-b7b7-0a89c329d025"],
 " is a narcissistic number in base 4.\n\n",
 StyleBox["Narcissistic numbers with a different definition.\n",
  FontWeight->"Bold",
  FontColor->GrayLevel[0.5]],
 StyleBox["\n",
  FontWeight->"Bold"],
 "Narcissistic numbers with increasing exponents: 2427 = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "1"], TraditionalForm]],ExpressionUUID->
  "112dc67f-7a5e-4169-82ee-501e37efcdba"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    RowBox[{"2", " "}]], TraditionalForm]],ExpressionUUID->
  "058ec621-bbe5-420e-9482-e58c71790d33"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "3"], TraditionalForm]],ExpressionUUID->
  "a6ef974a-6b47-430e-8a32-16bafbbb6591"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["7", "4"], TraditionalForm]],ExpressionUUID->
  "f4fb0c5a-8434-4f90-80e5-fe7110c368d2"],
 " = 2 + 16 + 8 + 2401 = 2427\n\nNarcissistic numbers with constant base: \
4624 = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    RowBox[{"4", " "}]], TraditionalForm]],ExpressionUUID->
  "88d518c4-0de5-4423-ba8d-d93a9a9662ee"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "6"], TraditionalForm]],ExpressionUUID->
  "e1f799e0-bd80-489f-9ca4-6443cafe2ea9"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "2"], TraditionalForm]],ExpressionUUID->
  "f79b76bd-3feb-48b2-b0af-e6226fbe6807"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "4"], TraditionalForm]],ExpressionUUID->
  "7bfe3ee5-52f9-4e08-bca2-6a019d219151"],
 " = 256 + 4096 + 16 + 256 = 4624\n\nFactorion Numbers: 145 = 1! + 4! + 5! = \
1 + 24 + 120 = 145\n\n-> With minor adjustments our approaches can also be \
applied to these types of narcissistic numbers"
}], "Text",
 CellMargins->{{92, 21}, {5, 5}},
 CellChangeTimes->{{3.991184593237754*^9, 3.991184599031465*^9}, 
   3.991184965499085*^9, {3.991660806829227*^9, 3.9916610373684263`*^9}, {
   3.9916611129582243`*^9, 3.9916611279157467`*^9}, {3.991661192787122*^9, 
   3.991661214761056*^9}},ExpressionUUID->"ccb43663-5490-4a85-9d6d-\
71ed2905eb3f"]
}, Open  ]]
}, Open  ]],

