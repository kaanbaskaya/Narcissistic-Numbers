  3.6943456316374636`*^9, 3.990602736735302*^9, {3.99060277047433*^9, 
   3.990602770906074*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"c0166dfb-5437-421e-ad2d-918a0b809494"]
}, Open  ]],

