Cell["\<\
The following function returns all narcissistic numbers in the interval from \
0 up to a given number n. In addition, it returns the time required for the \
calculation.\
\>", "Text",
 CellChangeTimes->{{3.9906169734976215`*^9, 3.9906170377179604`*^9}, {
   3.9906175370441666`*^9, 3.990617579828409*^9}, {3.990617707753687*^9, 
   3.990617708190737*^9}, {3.99063533059029*^9, 3.9906353360428505`*^9}, 
   3.990638322137144*^9},ExpressionUUID->"80c5a2e8-1242-784c-ba8e-\
17273da2e0c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissistic", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time", ",", "numbers"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "n"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"QF", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990617599662073*^9, 3.990617664656868*^9}, 
   3.990618237536316*^9, {3.990618360700424*^9, 3.9906183610966434`*^9}, {
   3.9906184195835953`*^9, 3.990618419826868*^9}, {3.9906349580251102`*^9, 
   3.9906349661926003`*^9}, 3.9906353201188393`*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"a42d7c75-c455-9143-8bab-8e15f1090ef7"],

Cell["", "Text",
 CellChangeTimes->{{3.99061963402886*^9, 3.9906196755650177`*^9}, {
  3.990635121366932*^9, 
  3.990635122639929*^9}},ExpressionUUID->"c25b6eb0-cccf-0940-9bd2-\
62a9e3d2e3c2"],

Cell[CellGroupData[{

Cell["4.1 Bruteforce", "Subsection",
 CellChangeTimes->{{3.6943454921732183`*^9, 3.694345497976429*^9}, {
  3.990603412743681*^9, 
  3.990603415436069*^9}},ExpressionUUID->"3847f262-4c0c-46d6-85cc-\
4ef49cf728fc"],

Cell["\<\
Brute force describes an algorithmic approach in which all possible \
candidates are tested until a solution is found. Since this method does not \
use any filtering or optimization strategies, it is computationally more \
expensive than more advanced algorithms.

In this case, the brute force approach checks every number within the given \
range. For each number, the quality function is evaluated in order to \
determine whether the number is narcissistic or not.

Source: https://dl.acm.org/doi/10.1145/3107239, accessed June 16, 2026.

The following table shows all narcissistic numbers found up to each power of \
10, as well as the corresponding computation time.\
\>", "Text",
 CellChangeTimes->{{3.6551323318137064`*^9, 3.655132346618133*^9}, {
   3.6558834788297663`*^9, 3.655883482105772*^9}, {3.655883581805547*^9, 
   3.655883589683561*^9}, {3.6558837346868153`*^9, 3.655883735919217*^9}, {
   3.694341574232729*^9, 3.694341596852769*^9}, {3.694342244717239*^9, 
   3.694342247462844*^9}, {3.694342333660995*^9, 3.694342343083412*^9}, {
   3.6943424202555304`*^9, 3.694342429299047*^9}, {3.6943424762647333`*^9, 
   3.694342484642213*^9}, {3.694342535512122*^9, 3.694342552269081*^9}, {
   3.6943425832578535`*^9, 3.694342597036641*^9}, {3.694342646046445*^9, 
   3.694342765915301*^9}, {3.694342880577859*^9, 3.694342892973568*^9}, {
   3.920005136849468*^9, 3.9200051373384686`*^9}, {3.9906160850350018`*^9, 
   3.9906161999241543`*^9}, {3.9906162638379383`*^9, 3.990616439409483*^9}, {
   3.99061650338826*^9, 3.990616525095356*^9}, {3.9906191208810863`*^9, 
   3.990619219295412*^9}, {3.9906197550528145`*^9, 3.990619775008501*^9}, {
   3.9906354081481247`*^9, 3.9906354149784565`*^9}, 3.990638348882786*^9, {
   3.9906392814911156`*^9, 
   3.990639287158844*^9}},ExpressionUUID->"dd5889fc-b7b8-1e4d-ac00-\
ef278f9515c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rows", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"numbers", ",", "time"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"numbers", ",", "time"}], "}"}], "=", 
          RowBox[{"returnNarcissistic", "[", 
           RowBox[{"10", "^", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Superscript", "[", 
            RowBox[{"10", ",", "k"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"numbers", ",", "\"\<; \>\""}], "]"}], ",", 
