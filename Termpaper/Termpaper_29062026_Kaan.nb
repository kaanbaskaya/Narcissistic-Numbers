Cell["\<\
The plot confirms the different growth behavior of the two approaches. The \
number of brute force candidates grows exponentially with the digit length, \
which appears as a straight line on the logarithmic scale. In contrast, the \
number of digit permutation classes grows much more slowly. This visualizes \
why the brute force approach becomes increasingly sensitive to digit length, \
while the digit permutation class approach is less affected by larger search \
dimensions.\
\>", "Text",
 CellChangeTimes->{
  3.9915568755388527`*^9, {3.9915572352566566`*^9, 
   3.991557237157961*^9}},ExpressionUUID->"bdf7db9a-00a6-9643-8779-\
a4ca778a6523"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Sensitivity to Algorithmic Approach", "Subsection",
 CellChangeTimes->{{3.6943454921732183`*^9, 3.6943455089276485`*^9}, 
   3.694345564760146*^9, {3.9912774235680695`*^9, 
   3.991277436265995*^9}},ExpressionUUID->"ac421074-9c7e-4b28-a774-\
30afc3ef147f"],

Cell["\<\
The second sensitivity analysis compares the runtime behavior of the \
different algorithmic approaches. To make the comparison fair, all approaches \
are applied to the same digit intervals. This means that for each digit \
length d, only numbers with exactly d digits are considered.

This avoids repeatedly recalculating smaller numbers and allows the marginal \
runtime increase per digit dimension to be observed more clearly. The \
comparison shows how sensitive each algorithm is to an increase in the size \
of the search space.

The expectation is that the brute force methods will show the strongest \
runtime increase, because they process every candidate number individually. \
The digit permutation class approaches should be less sensitive to the digit \
length, since they operate on digit vectors instead of individual numbers.\
\>", "Text",
 CellChangeTimes->{{3.6551323318137064`*^9, 3.655132346618133*^9}, {
   3.6558834788297663`*^9, 3.655883482105772*^9}, {3.655883581805547*^9, 
   3.655883589683561*^9}, {3.6558837346868153`*^9, 3.655883735919217*^9}, {
   3.694341574232729*^9, 3.694341596852769*^9}, {3.694342244717239*^9, 
   3.694342247462844*^9}, {3.694342333660995*^9, 3.694342343083412*^9}, {
   3.6943424202555304`*^9, 3.694342429299047*^9}, {3.6943424762647333`*^9, 
   3.694342484642213*^9}, {3.694342535512122*^9, 3.694342552269081*^9}, {
   3.6943425832578535`*^9, 3.694342597036641*^9}, {3.694342646046445*^9, 
   3.694342765915301*^9}, {3.694342880577859*^9, 3.694342892973568*^9}, {
   3.920005136849468*^9, 3.9200051373384686`*^9}, 
   3.9912774448397465`*^9},ExpressionUUID->"265f2e2c-a6d0-454c-886b-\
9550135d66d4"],

Cell["\<\
The following table compares the runtime behavior of the implemented \
approaches for fixed digit intervals. Each method is executed several times, \
and the table reports the mean runtime, standard deviation, number of \
completed runs, and number of narcissistic numbers found.\
\>", "Text",
 CellChangeTimes->{{3.991557656616192*^9, 
  3.991557671726742*^9}},ExpressionUUID->"4922b331-f284-3a4e-a59f-\
be39070c6ff2"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"measureRuntime", ",", "formatRuntimeRow"}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"measureRuntime", "[", 
     RowBox[{"name_", ",", "func_", ",", "d_Integer", ",", 
      RowBox[{"repetitions_", ":", "3"}], ",", 
      RowBox[{"timeLimit_", ":", "120"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "lower", ",", "upper", ",", "runs", ",", "successfulRuns", ",", 
        "times", ",", "nums", ",", "t"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lower", ",", "upper"}], "}"}], "=", 
        RowBox[{"dimensionRange", "[", "d", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"runs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"TimeConstrained", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"nums", ",", "t"}], "}"}], "=", 
              RowBox[{"func", "[", 
               RowBox[{"lower", ",", "upper"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"nums", ",", "t"}], "}"}]}], ",", "timeLimit", ",", 
            "$Failed"}], "]"}], ",", 
          RowBox[{"{", "repetitions", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"successfulRuns", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"runs", ",", "$Failed"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"successfulRuns", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"name", ",", "d", ",", "lower", ",", "upper", ",", "0", ",", 
           RowBox[{"Missing", "[", "\"\<Timeout\>\"", "]"}], ",", 
           RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], ",", 
           RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"times", "=", 
           RowBox[{"successfulRuns", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"name", ",", "d", ",", "lower", ",", "upper", ",", 
            RowBox[{"Length", "[", "successfulRuns", "]"}], ",", 
            RowBox[{"Mean", "[", "times", "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "times", "]"}], ">", "1"}], ",", 
              RowBox[{"StandardDeviation", "[", "times", "]"}], ",", "0"}], 
             "]"}], ",", 
            RowBox[{"Length", "[", 
             RowBox[{
              RowBox[{"First", "[", "successfulRuns", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}]}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"formatRuntimeRow", "[", "row_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "name", ",", "d", ",", "lower", ",", "upper", ",", "completed", ",", 
        "mean", ",", "sd", ",", "found"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "name", ",", "d", ",", "lower", ",", "upper", ",", "completed", ",", 
          "mean", ",", "sd", ",", "found"}], "}"}], "=", "row"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"name", ",", "d", ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"lower", ",", "\"\< - \>\"", ",", "upper"}], "}"}], "]"}], 
         ",", "completed", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "mean", "]"}], "===", "Missing"}], 
           ",", "\"\<timeout\>\"", ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"mean", ",", 
             RowBox[{"{", 
              RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "sd", "]"}], "===", 
            RowBox[{"M", "\[IndentingNewLine]", "issing"}]}], ",", "\"\<-\>\"",
            ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"sd", ",", 
             RowBox[{"{", 
              RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "found", "]"}], "===", "Missing"}], 
           ",", "\"\<-\>\"", ",", "found"}], "]"}]}], "}"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{
  3.6943456316374636`*^9, 3.991277456707369*^9, {3.991672011163851*^9, 
   3.9916720236600456`*^9}, {3.9916720639652615`*^9, 3.9916720648286533`*^9}, 
   3.9916767793603573`*^9},ExpressionUUID->"544df5c7-b852-4deb-8f75-\
49c295d8a768"],

