Cell["\<\
The following function returns all narcissistic numbers in an interval and  \
the time required for the calculation.\
\>", "Text",
 CellChangeTimes->{{3.9906169734976215`*^9, 3.9906170377179604`*^9}, {
   3.9906175370441666`*^9, 3.990617579828409*^9}, {3.990617707753687*^9, 
   3.990617708190737*^9}, {3.99063533059029*^9, 3.9906353360428505`*^9}, 
   3.990638322137144*^9, {3.9909481593498707`*^9, 
   3.99094817632703*^9}},ExpressionUUID->"80c5a2e8-1242-784c-ba8e-\
17273da2e0c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissisticRange", "[", 
   RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time", ",", "numbers"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"lower", ",", "upper"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"QF", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990617599662073*^9, 3.990617664656868*^9}, 
   3.990618237536316*^9, {3.990618360700424*^9, 3.9906183610966434`*^9}, {
   3.9906184195835953`*^9, 3.990618419826868*^9}, {3.9906349580251102`*^9, 
   3.9906349661926003`*^9}, 3.9906353201188393`*^9, 3.9909481490200596`*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"a42d7c75-c455-9143-8bab-8e15f1090ef7"],

