  3.9912878950202713`*^9, 3.991671715524193*^9, 3.991671771573721*^9, 
  3.991672881754839*^9, 3.9917228507639313`*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"c9d55592-04a2-8d49-a7c5-911a9e53b195"]
