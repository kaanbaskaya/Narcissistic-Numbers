classes\"\>", "\<\"Reduction factor\"\>"},
    {"1", "10", "10", 
     TagBox[
      InterpretationBox[
       StyleBox["\<\"1.00\"\>",
        ShowStringCharacters->False],
       1.,
       AutoDelete->True],
      NumberForm[#, {
        DirectedInfinity[1], 2}]& ]},
