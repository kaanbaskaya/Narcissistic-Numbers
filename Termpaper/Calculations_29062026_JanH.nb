           RowBox[{"NumberForm", "[", 
            RowBox[{"time", ",", 
             RowBox[{"{", 
              RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}]}], "}"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "maxdimension"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Table4", " ", "=", " ", 
