Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "dimensionRange", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimensionRange", "[", "d_Integer", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"d", "==", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"10", "^", "d"}], "-", "1"}]}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxdimensionParallelBF", "=", "8"}], ";"}]}], "Input",
 CellChangeTimes->{{3.991710051954424*^9, 3.9917100573009796`*^9}, {
  3.9917103058531075`*^9, 3.991710306143133*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"13061fd4-25e3-9b4e-b450-2334a31fefe5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "returnNarcissisticParallelRange", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"returnNarcissisticParallelRange", "[", 
   RowBox[{"lower_Integer", ",", "upper_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time", ",", "numbers"}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$KernelCount", "==", "0"}], ",", 
       RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DistributeDefinitions", "[", 
      RowBox[{"F", ",", "QF"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QF", "[", "i", "]"}], "==", "0"}], ",", "i", ",", 
           "Nothing"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "lower", ",", "upper"}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{3.9917100858348713`*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"44aabdd9-10b4-2f4f-b66d-37593c0292aa"],

