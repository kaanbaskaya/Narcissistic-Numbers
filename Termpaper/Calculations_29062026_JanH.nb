Cell[BoxData[
 RowBox[{
  RowBox[{"digitVector", "[", "n_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{
      RowBox[{"IntegerDigits", "[", "n", "]"}], ",", "d"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"d", ",", "0", ",", "9"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.991710770362583*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"e1317c33-43de-de42-abcd-a998ae16dd54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"digitVectorsOfLength", "[", "digits_", "]"}], ":=", 
  RowBox[{"FrobeniusSolve", "[", 
   RowBox[{
    RowBox[{"ConstantArray", "[", 
     RowBox[{"1", ",", "10"}], "]"}], ",", "digits"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permutationClassVectorPowerSum", "[", "v_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "digits", "}"}], ",", 
    RowBox[{
     RowBox[{"digits", "=", 
      RowBox[{"Total", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", 
          RowBox[{"d", "+", "1"}], "]"}], "]"}], "*", 
        RowBox[{"d", "^", "digits"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "0", ",", "9"}], "}"}]}], "]"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{3.991710776991911*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"205ee1bb-8b37-8d45-93d4-279e335a71d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissisticPermutationRange", "[", 
   RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "time", ",", "numbers", ",", "minDigits", ",", "maxDigits", ",", 
      "vectors"}], "}"}], ",", 
    RowBox[{
     RowBox[{"minDigits", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"IntegerLength", "[", "lower", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxDigits", "=", 
      RowBox[{"IntegerLength", "[", "upper", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"vectors", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"digitVectorsOfLength", "[", "d", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "minDigits", ",", "maxDigits"}], "}"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numbers", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "value", "}"}], ",", 
             RowBox[{
              RowBox[{"value", "=", 
               RowBox[{"permutationClassVectorPowerSum", "[", "v", "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"lower", "<=", "value", "<=", "upper"}], "&&", 
                 RowBox[{
                  RowBox[{"digitVector", "[", "value", "]"}], "==", "v"}]}], ",",
                 "value", ",", "Nothing"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"v", ",", "vectors"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"DeleteDuplicates", "[", "numbers", "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.991710792988123*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"726db094-5d87-a245-9d38-88cdd56f3e10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rows", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lower", ",", "upper", ",", "numbers", ",", "time"}], "}"}], 
        ",", 
        RowBox[{
         RowBox[{"upper", "=", 
          RowBox[{"10", "^", "k"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lower", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", "==", "0"}], ",", "0", ",", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]}], "+", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"numbers", ",", "time"}], "}"}], "=", 
          RowBox[{"returnNarcissisticPermutationRange", "[", 
           RowBox[{"lower", ",", "upper"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Superscript", "[", 
