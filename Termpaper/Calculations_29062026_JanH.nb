Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissisticPermutationRangeParallel", "[", 
   RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "time", ",", "numbers", ",", "minDigits", ",", "maxDigits", ",", 
      "vectors"}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$KernelCount", "==", "0"}], ",", 
       RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DistributeDefinitions", "[", 
      RowBox[{
      "digitVector", ",", "digitVectorsOfLength", ",", 
       "permutationClassVectorPowerSum"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minDigits", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"IntegerLength", "[", "lower", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxDigits", "=", 
      RowBox[{"IntegerLength", "[", "upper", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"vectors", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"digitVectorsOfLength", "[", "d", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "minDigits", ",", "maxDigits"}], "}"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"numbers", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "value", "}"}], ",", 
             RowBox[{
              RowBox[{"value", "=", 
               RowBox[{"permutationClassVectorPowerSum", "[", "v", "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"lower", "<=", "value", "<=", "upper"}], "&&", 
                 RowBox[{
                  RowBox[{"digitVector", "[", "value", "]"}], "==", "v"}]}], ",",
                 "value", ",", "Nothing"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"v", ",", "vectors"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Sort", "[", 
         RowBox[{"DeleteDuplicates", "[", "numbers", "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9917109612718983`*^9, 3.991710963628086*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"64176543-d635-eb41-9b1b-859be3cee9b4"],

