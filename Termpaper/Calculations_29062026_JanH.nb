   3.9917114667227306`*^9}},ExpressionUUID->"e0ce679d-baae-4e3f-955a-\
2426a5ad958a"],

Cell[CellGroupData[{

Cell["4.1 Sensitivity to Search Dimensions", "Subsection",
 CellChangeTimes->{{3.6943454921732183`*^9, 3.694345497976429*^9}, 
   3.991711476356413*^9},ExpressionUUID->"3847f262-4c0c-46d6-85cc-\
4ef49cf728fc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"candidateCount", ",", "digitClassCount"}], "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"candidateCount", "[", "d_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"d", "==", "1"}], ",", "10", ",", 
     RowBox[{"9", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"digitClassCount", "[", "d_", "]"}], ":=", 
   RowBox[{"Binomial", "[", 
    RowBox[{
     RowBox[{"d", "+", "9"}], ",", "9"}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"complexityRows", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"d", ",", 
        RowBox[{"candidateCount", "[", "d", "]"}], ",", 
        RowBox[{"digitClassCount", "[", "d", "]"}], ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"candidateCount", "[", "d", "]"}], "/", 
            RowBox[{"digitClassCount", "[", "d", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"Infinity", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "1", ",", "maxdimension"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Table5", " ", "=", " ", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"complexityRows", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Digit length\>\"", ",", "\"\<Brute force candidates\>\"", 
        ",", "\"\<Digit classes\>\"", ",", "\"\<Reduction factor\>\""}], 
       "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "->", "All"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.991711486194708*^9, 3.9917114901011257`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"ee3f29c8-ef92-2d42-8a70-0ba0fd5199bf"],

