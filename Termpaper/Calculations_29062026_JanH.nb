Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rows", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lower", ",", "upper", ",", "numbers", ",", "time"}], "}"}], 
        ",", 
        RowBox[{
         RowBox[{"upper", "=", 
          RowBox[{"10", "^", "k"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lower", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", "==", "0"}], ",", "0", ",", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]}], "+", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"numbers", ",", "time"}], "}"}], "=", 
          RowBox[{"returnNarcissisticRange", "[", 
           RowBox[{"lower", ",", "upper"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Superscript", "[", 
            RowBox[{"10", ",", "k"}], "]"}], ",", 
           RowBox[{"Row", "[", 
