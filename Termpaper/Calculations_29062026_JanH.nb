Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"measureRuntime", ",", "formatRuntimeRow"}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measureRuntime", "[", 
    RowBox[{"name_", ",", "func_", ",", "d_Integer", ",", 
     RowBox[{"repetitions_", ":", "3"}], ",", 
     RowBox[{"timeLimit_", ":", "600"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "lower", ",", "upper", ",", "runs", ",", "successfulRuns", ",", "times",
        ",", "nums", ",", "t"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lower", ",", "upper"}], "}"}], "=", 
       RowBox[{"dimensionRange", "[", "d", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"runs", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"nums", ",", "t"}], "}"}], "=", 
             RowBox[{"func", "[", 
              RowBox[{"lower", ",", "upper"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"nums", ",", "t"}], "}"}]}], ",", "timeLimit", ",", 
           "$Failed"}], "]"}], ",", 
         RowBox[{"{", "repetitions", "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"successfulRuns", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"runs", ",", "$Failed"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"successfulRuns", "===", 
