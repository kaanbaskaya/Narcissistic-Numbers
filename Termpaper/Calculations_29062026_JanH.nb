Cell[BoxData[
 RowBox[{
  RowBox[{"returnNarcissisticRange", "[", 
   RowBox[{"lower_", ",", "upper_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"time", ",", "numbers"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "numbers"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"lower", ",", "upper"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"QF", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"numbers", ",", "time"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.991709751072817*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"d56ef69f-b284-fc40-94f9-eed000b040cf"]
}, Open  ]],

